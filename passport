#!/usr/bin/env bash
# passport — troubleshoot any URL from any country, using the public Globalping
# and check-host.net probe networks. It can also validate honeypot/WAF traps
# end to end. See README.md.
# Developed by p0intsec — https://github.com/p0intsec/passport
#
# Shortcut:
#   passport CC[,CC...] URL      e.g. passport KZ https://example.com
#                                     passport BR,DE,JP https://example.com/status
#
# Commands:
#   passport availability [CC]
#       Dashboard of the countries and servers online right now on both networks.
#       With CC (e.g. KZ), lists cities, providers and ASNs in that country.
#
#   passport request --url URL (--country CC[,CC...] | --node NODE) [options]
#       Sends a request from the country/node and shows status, timing and probe.
#       --method GET|HEAD   (default GET)
#       --probes N          probes per request (Globalping, default 1 per country)
#
#   passport trap-test --host HOST (--country CC | --node NODE) [options]
#       4-step run to validate a honeypot/WAF trap:
#         1. canary   — is the host behind the protection? (GET on the canary path)
#         2. bait     — the probe requests the trap path
#         3. block    — the SAME probe requests "/" and must be blocked
#         4. control  — a probe from another country requests "/" and must pass
#       --path P             trap path (default /wp-login.php on Globalping, /.env on check-host)
#       --canary-path P      default /robots.txt
#       --canary-text T      text expected in the canary (without it, step 1 is skipped)
#       --expect-bait N      expected status on the bait (default 200)
#       --expect-block N     expected status on the block check (default 403)
#       --control CC         control country (default US)
#       --on-finish CMD      command run at the end (e.g. your unblock), with
#                            PC_HOST, PC_PATH, PC_START_MS, PC_IP (check-host only),
#                            PC_PROBE_COUNTRY, PC_PROBE_ASN, PC_PROBE_NETWORK
#
# Global options:
#   --residential   allow residential probes on Globalping (default: datacenter only)
#   -h, --help      -v, --version
#
# Requirements: bash 4+, curl, python3. No account or token: uses the public
# APIs (unauthenticated Globalping ≈ 250 measurements/hour).

set -euo pipefail

VERSION="2.0.0"
FAILURES=0
GP="https://api.globalping.io/v1"
CH="https://check-host.net"
UA="passport/$VERSION (+https://github.com/p0intsec/passport)"

usage() { sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

if [[ -t 1 ]]; then GREEN=$'\033[32m'; RED=$'\033[31m'; YELLOW=$'\033[33m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else GREEN=""; RED=""; YELLOW=""; BOLD=""; RESET=""; fi
pass() { printf "  %s✔%s %s\n" "$GREEN" "$RESET" "$*"; }
fail() { printf "  %s✘%s %s\n" "$RED" "$RESET" "$*"; FAILURES=$((FAILURES + 1)); }
warn() { printf "  %s!%s %s\n" "$YELLOW" "$RESET" "$*"; }
die()  { printf "%serror:%s %s\n" "$RED" "$RESET" "$*" >&2; exit 2; }

for dep in curl python3; do command -v "$dep" >/dev/null || die "$dep is required"; done

json() { python3 -c "import json,sys; d=json.load(sys.stdin); $1"; }
get()  { curl -s --max-time 30 -A "$UA" -H "Accept: application/json" "$@"; }

# --- Globalping ---------------------------------------------------------------
TAGS='"datacenter-network"'
gp_locations() { # "KZ" or "BR,DE,JP" → locations (JSON), one entry per country
  local cc out="" sep="" countries
  IFS=',' read -ra countries <<< "$1"
  for cc in "${countries[@]}"; do
    if [[ -n "$TAGS" ]]; then out+="$sep{\"country\":\"$cc\",\"tags\":[$TAGS]}"; else out+="$sep{\"country\":\"$cc\"}"; fi
    sep=","
  done
  echo "[$out]"
}

# Creates the measurement and waits for it. Output: one line per probe
#   status|ms|country|city|network|ASN|measurement_id      (or "error|reason")
# locations can be countries or the quoted id of a previous measurement —
# the latter reuses EXACTLY the same probes (same IP).
gp_http() { # $1=target(host) $2=path $3=locations $4=method $5=limit $6=protocol
  local resp id r
  resp=$(curl -s --max-time 30 -A "$UA" -X POST "$GP/measurements" -H "Content-Type: application/json" -d "{
    \"type\":\"http\",\"target\":\"$1\",\"locations\":$3,\"limit\":${5:-1},
    \"measurementOptions\":{\"protocol\":\"${6:-HTTPS}\",\"request\":{\"method\":\"${4:-GET}\",\"path\":\"$2\"}}}")
  id=$(echo "$resp" | json "print(d.get('id',''))")
  if [[ -z "$id" ]]; then
    # The reason comes in the SAME response — never resend the request just to read the error.
    echo "error|$(echo "$resp" | json "e=d.get('error',{}); print('; '.join(str(v) for v in (e.get('params') or {}).values()) or e.get('message','no probe available'))")"
    return
  fi
  for _ in $(seq 1 25); do
    sleep 2
    r=$(get "$GP/measurements/$id")
    if [[ $(echo "$r" | json "print(d.get('status'))") != in-progress ]]; then
      echo "$r" | json "
for x in d.get('results', []):
    p, res = x['probe'], x['result']
    print(f\"{res.get('statusCode') or 'error'}|{res.get('timings',{}).get('total','?')}|{p['country']}|{p['city']}|{p['network']}|{p['asn']}|$id\")"
      return
    fi
  done
  echo "error|timed out waiting for measurement $id"
}

# --- check-host.net -----------------------------------------------------------
ch_ip() { get "$CH/nodes/hosts" | json "print(d['nodes'].get('$1.node.check-host.net',{}).get('ip',''))"; }
ch_http() { # $1=node $2=url → status|ms
  local id r
  id=$(get "$CH/check-http?host=$2&node=$1.node.check-host.net" | json "print(d.get('request_id',''))")
  [[ -z "$id" ]] && { echo "error|check-host rejected the request"; return; }
  for _ in $(seq 1 15); do
    sleep 2
    r=$(get "$CH/check-result/$id")
    if ! echo "$r" | grep -q null; then
      echo "$r" | json "
v=list(d.values())[0][0]
print(f\"{v[3] if len(v)>3 and v[3] else 'error'}|{round(v[1]*1000) if v[1] else '?'}\")"
      return
    fi
  done
  echo "error|timed out"
}

# =============================================================================
cmd_availability() {
  local target="${1:-}" tmp
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  get "$CH/nodes/hosts" > "$tmp/ch.json"
  get "$GP/probes" > "$tmp/gp.json"
  python3 - "$tmp/ch.json" "$tmp/gp.json" "${target^^}" "$BOLD" "$RESET" <<'PY'
import json, sys, collections
ch = json.load(open(sys.argv[1]))["nodes"]
gp = json.load(open(sys.argv[2]))
target, B, R = sys.argv[3], sys.argv[4], sys.argv[5]
names, nodes = {}, collections.defaultdict(list)
for host, v in ch.items():
    cc = v["location"][0].upper(); names[cc] = v["location"][1]
    nodes[cc].append((host.split(".")[0], v["location"][2], v.get("ip", ""), v.get("asn", "")))
dc, res, probes = collections.Counter(), collections.Counter(), collections.defaultdict(list)
for p in gp:
    loc = p["location"]; cc = loc["country"]
    kind = "datacenter" if "datacenter-network" in (p.get("tags") or []) else "residential"
    (dc if kind == "datacenter" else res)[cc] += 1
    probes[cc].append((loc.get("city") or "?", loc.get("network") or "?", loc.get("asn"), kind))

if target:
    print(f"\n  {B}{target}{R} {names.get(target, '')}")
    print(f"  {B}check-host.net{R} (use --node <node>)")
    for node, city, ip, asn in sorted(nodes.get(target, [])):
        print(f"    {node:6} {city:20} {ip:16} {asn}")
    if not nodes.get(target): print("    — no nodes")
    print(f"  {B}Globalping{R} (use --country {target})")
    c = collections.Counter(probes.get(target, []))
    for (city, network, asn, kind), n in sorted(c.items(), key=lambda x: (x[0][3] != "datacenter", -x[1])):
        print(f"    {n:3}x {kind:11} {city:20} {network[:36]:36} AS{asn}")
    if not c: print("    — no probes")
    sys.exit(0)

countries = sorted(set(dc) | set(res) | set(nodes))
print(f"\n  {B}Availability right now{R} — check-host: {len(ch)} nodes · Globalping: {len(gp)} probes in {len(set(dc)|set(res))} countries\n")
print(f"  {'CC':4}  {'check-host':24} {'Globalping DC':>13} {'resid.':>7}")
print(f"  {'-'*4}  {'-'*24} {'-'*13} {'-'*7}")
for cc in countries:
    node_list = ",".join(sorted(n for n, *_ in nodes.get(cc, [])))
    d, r = dc.get(cc, 0), res.get(cc, 0)
    note = "  (residential only)" if not (node_list or d) else ""
    print(f"  {cc:4}  {node_list[:24]:24} {d:13} {r:7}{note}")
print("\n  Datacenter probes only by default. Details for one country: passport availability KZ")
PY
}

# =============================================================================
cmd_request() {
  local url="" country="" node="" method="GET" probes=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --url) url="$2"; shift 2 ;;
      --country) country="${2^^}"; shift 2 ;;
      --node) node="${2%%.*}"; shift 2 ;;
      --method) method="${2^^}"; shift 2 ;;
      --probes) probes="$2"; shift 2 ;;
      --residential) TAGS=""; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ -z "$url" ]] && die "missing --url"
  [[ -z "$country" && -z "$node" ]] && die "use --country or --node"
  [[ "$url" != http*://* ]] && url="https://$url"

  local st ms
  if [[ -n "$node" ]]; then
    local ip; ip=$(ch_ip "$node"); [[ -z "$ip" ]] && die "node $node does not exist (see: passport availability)"
    IFS='|' read -r st ms < <(ch_http "$node" "$url")
    printf "  %-6s %-16s → HTTP %s  %s ms\n" "$node" "$ip" "$st" "$ms"
    if [[ "$st" == error ]]; then exit 1; fi
    return 0
  fi

  local proto host path rc=0 n_countries p city network asn
  proto=$(python3 -c "import sys,urllib.parse;print(urllib.parse.urlsplit(sys.argv[1]).scheme.upper())" "$url")
  host=$(python3 -c "import sys,urllib.parse;print(urllib.parse.urlsplit(sys.argv[1]).hostname)" "$url")
  path=$(python3 -c "import sys,urllib.parse;u=urllib.parse.urlsplit(sys.argv[1]);print((u.path or '/')+('?'+u.query if u.query else ''))" "$url")
  n_countries=$(awk -F, '{print NF}' <<< "$country")
  (( probes < n_countries )) && probes=$n_countries
  while IFS='|' read -r st ms p city network asn _; do
    if [[ "$st" == error ]]; then echo "  Globalping rejected the request: $ms"; rc=1; continue; fi
    printf "  %-2s %-18s %-30s AS%-7s → HTTP %s  %s ms\n" "$p" "$city" "${network:0:30}" "$asn" "$st" "$ms"
  done < <(gp_http "$host" "$path" "$(gp_locations "$country")" "$method" "$probes" "$proto")
  return $rc
}

# =============================================================================
cmd_trap_test() {
  local host="" country="" node="" path="" canary="/robots.txt" text="" exp_bait=200 exp_block=403 control="US" on_finish=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --country) country="${2^^}"; shift 2 ;;
      --node) node="${2%%.*}"; shift 2 ;;
      --path) path="$2"; shift 2 ;;
      --canary-path) canary="$2"; shift 2 ;;
      --canary-text) text="$2"; shift 2 ;;
      --expect-bait) exp_bait="$2"; shift 2 ;;
      --expect-block) exp_block="$2"; shift 2 ;;
      --control) control="${2^^}"; shift 2 ;;
      --on-finish) on_finish="$2"; shift 2 ;;
      --residential) TAGS=""; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ -z "$host" ]] && die "missing --host"
  [[ -z "$country" && -z "$node" ]] && die "use --country or --node"
  [[ -z "$path" ]] && { [[ -n "$country" ]] && path="/wp-login.php" || path="/.env"; }

  FAILURES=0
  local start; start=$(python3 -c "import time;print(int(time.time()*1000))")
  local pc="" pasn="" pnet="" ip="" st ms city mid st2
  echo "${BOLD}passport — trap test${RESET}"
  echo "  host: $host   bait: $path   origin: ${country:+country $country}${node:+node $node}   control: $control"
  echo

  echo "1) Canary ($canary)"
  if [[ -z "$text" ]]; then
    warn "skipped (no --canary-text)"
  elif curl -s --max-time 15 -A "$UA" "https://$host$canary" | grep -qF "$text"; then
    pass "canary text found — host is behind the protection"
  else
    fail "canary text not found — the host is NOT behind the protection; nothing else was tested"; return 1
  fi

  if [[ -n "$country" ]]; then
    echo "2) Bait from $country"
    IFS='|' read -r st ms pc city pnet pasn mid < <(gp_http "$host" "$path" "$(gp_locations "$country")" GET 1 HTTPS)
    if [[ "$st" == error ]]; then fail "Globalping rejected the request: $ms"; return 1; fi
    echo "     probe: $city/$pc — $pnet (AS$pasn)"
    [[ "$st" == "$exp_bait" ]] && pass "HTTP $st in ${ms} ms" || fail "expected $exp_bait, got $st"
    echo "3) Same probe requests /"
    IFS='|' read -r st2 _ < <(gp_http "$host" "/" "\"$mid\"" GET 1 HTTPS)
  else
    ip=$(ch_ip "$node"); [[ -z "$ip" ]] && die "node $node does not exist"
    echo "2) Bait from node $node ($ip)"
    IFS='|' read -r st ms < <(ch_http "$node" "https://$host$path")
    [[ "$st" == "$exp_bait" ]] && pass "HTTP $st in ${ms} ms" || fail "expected $exp_bait, got $st"
    echo "3) Same node requests /"
    IFS='|' read -r st2 _ < <(ch_http "$node" "https://$host/")
  fi
  [[ "$st2" == "$exp_block" ]] && pass "blocked (HTTP $st2)" || fail "expected $exp_block, got $st2"

  echo "4) Control: $control requests /"
  local st3 ms3 p3 c3
  IFS='|' read -r st3 ms3 p3 c3 _ < <(gp_http "$host" "/" "$(gp_locations "$control")" GET 1 HTTPS)
  [[ "$st3" =~ ^[23] ]] && pass "HTTP $st3 in ${ms3} ms ($c3/$p3)" || fail "control should pass, got $st3"

  echo
  if [[ -n "$on_finish" ]]; then
    echo "5) --on-finish"
    if PC_HOST="$host" PC_PATH="$path" PC_START_MS="$start" PC_IP="$ip" \
       PC_PROBE_COUNTRY="${pc:-$node}" PC_PROBE_ASN="$pasn" PC_PROBE_NETWORK="$pnet" \
       bash -c "$on_finish"; then pass "finish command completed"; else fail "finish command failed"; fi
  else
    warn "the test origin may still be BLOCKED by your protection — remove it (or use --on-finish)"
  fi
  if [[ $FAILURES -eq 0 ]]; then echo "${GREEN}${BOLD}All good.${RESET}"; else echo "${RED}${BOLD}$FAILURES step(s) failed.${RESET}"; return 1; fi
}

# =============================================================================
[[ $# -eq 0 ]] && usage 2
# Shortcut: passport KZ https://example.com  |  passport BR,DE https://example.com
if [[ "$1" =~ ^[A-Za-z]{2}(,[A-Za-z]{2})*$ && $# -ge 2 ]]; then
  cc_list="${1^^}"; shift
  cmd_request --country "$cc_list" --url "$@"; exit $?
fi
cmd="$1"; shift
case "$cmd" in
  availability) cmd_availability "${1:-}" ;;
  request) cmd_request "$@" ;;
  trap-test) cmd_trap_test "$@" ;;
  -v|--version) echo "passport $VERSION" ;;
  -h|--help|help) usage 0 ;;
  *) die "unknown command: $cmd (see --help)" ;;
esac
